# Firebase web config. These are PUBLIC identifiers, not secrets -- Firestore
# security rules are what protect your data. Committed defaults live in
# src/lib/firebaseConfig.ts; these vars override them for local experiments.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key used by Firebase App Check.
VITE_APP_CHECK_SITE_KEY=

# Set to "1" to point the app at local emulators. `npm run emulators:configure`
# writes an ignored .env.emulators.local with the matching port values instead.
VITE_USE_EMULATORS=0
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# `npm run dev:emulators` reads this from .env.emulators.local. Keep a normal
# local Vite server on 5173 unless a worktree slot has been configured.
VITE_DEV_SERVER_PORT=5173
