{
  "name": "den-of-wolves-new-eden-console",
  "private": true,
  "version": "0.4.65",
  "type": "module",
  "description": "Den of Wolves: New Eden Unofficial Companion Console",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:bundle": "npm run build && node scripts/check-bundle-size.mjs",
    "test:pwa:rollover": "npm run build && node scripts/test-pwa-rollover-browser.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --project unit --project functions",
    "test:unit": "vitest run --project unit",
    "test:functions": "vitest run --project functions",
    "test:font-consistency": "vitest run --project unit src/styles/aesthetic.test.ts",
    "test:render:p591": "node scripts/prompt-591-render.mjs",
    "test:render:p602": "node scripts/prompt-602-return-navigation.mjs",
    "test:render:p583": "node scripts/prompt-583-render.mjs",
    "test:watch": "vitest --project unit",
    "test:ticker:browser": "node scripts/test-fleet-ticker-browser.mjs",
    "test:health-metrics": "node --test scripts/health-metrics.test.mjs",
    "test:health:p636": "npm run test:health-metrics && P638_EVIDENCE_PATH=/tmp/p636-callable-health.json node scripts/prompt-638-capacity-rehearsal.mjs --scenario=press && node scripts/validate-prompt-636-health.mjs /tmp/p636-callable-health.json",
    "test:capacity:p638": "node scripts/prompt-638-capacity-rehearsal.mjs --scenario=core && node scripts/prompt-638-capacity-rehearsal.mjs --scenario=press",
    "test:capacity:p639": "node scripts/prompt-639-browser-capacity.mjs && node scripts/validate-prompt-639-capacity.mjs",
    "test:capacity:p639:smoke": "node scripts/prompt-639-browser-capacity.mjs --clients=20 --duration-ms=30000 --smoke --evidence=/tmp/p639-browser-capacity-smoke.json",
    "test:rules": "node scripts/run-emulator-command.mjs rules",
    "test:growth": "node scripts/test-growth-gate.mjs",
    "security:threat-model": "node --test scripts/validate-threat-model.test.mjs && node scripts/validate-threat-model.mjs",
    "test:geometry:603a": "node scripts/prompt-603a-geometry.mjs",
    "test:performance:p637": "npm run build && node scripts/prompt-637-render-performance.mjs",
    "test:all": "npm run test && npm run test:rules",
    "coordination:status": "node scripts/emulator-resource-registry.mjs status",
    "coordination:dependencies": "node scripts/prompt-dependencies.mjs",
    "coordination:dependencies:measure": "node scripts/prompt-dependencies.mjs --measure",
    "roadmap:generate": "node scripts/generate-prompt-views.mjs",
    "roadmap:check": "node scripts/generate-prompt-views.mjs --check",
    "coordination:begin": "node scripts/emulator-resource-registry.mjs begin",
    "coordination:park": "node scripts/emulator-resource-registry.mjs park",
    "coordination:resume": "node scripts/emulator-resource-registry.mjs resume",
    "coordination:amend": "node scripts/emulator-resource-registry.mjs amend",
    "coordination:validate": "node scripts/emulator-resource-registry.mjs validate",
    "coordination:docs": "node scripts/validate-repository-guidance.mjs && node scripts/validate-implementation-progress.mjs",
    "validate:implementation-progress": "node scripts/validate-implementation-progress.mjs",
    "validate:dependencies": "node scripts/prompt-dependencies.mjs --verify",
    "validate:work-registration": "node scripts/validate-work-registration.mjs",
    "coordination:finish": "node scripts/emulator-resource-registry.mjs finish",
    "emulators:configure": "node scripts/configure-emulator-slot.mjs",
    "emulators": "npm run build --prefix functions && node scripts/run-emulator-command.mjs start",
    "dev:emulators": "node scripts/run-emulator-command.mjs vite",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "test:copy-consistency": "node scripts/player-copy-contract.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
