#!/bin/sh
set -eu

# Keep the removed proprietary source library unreachable. Deletions are safe;
# ordinary pushes do not require roadmap registration or a prompt trailer.
zero_oid=0000000000000000000000000000000000000000
updates_file=$(mktemp "${TMPDIR:-/tmp}/den-of-wolves-pre-push.XXXXXX")
trap 'rm -f "$updates_file"' EXIT HUP INT TERM
cat >"$updates_file"

blocked=0
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  if [ -n "$(git log -1 --format=%H "$local_oid" -- docs/reference)" ]; then
    echo "Blocked push of $local_ref to $remote_ref: its history still contains docs/reference." >&2
    echo "Rebase or cherry-pick the work onto the rewritten origin/main before pushing." >&2
    blocked=1
  fi
done <"$updates_file"

if [ "$blocked" -ne 0 ]; then
  exit "$blocked"
fi
