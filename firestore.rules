rules_version = '2';

// Den of Wolves: New Eden -- Unofficial Companion Console
//
// Principle: the client may READ what it is entitled to see and may write only
// its own presence document. Every authoritative mutation -- claiming a seat,
// elevating a GM, generating a secret or a random result -- goes through a
// callable Cloud Function running with admin privileges. Anything a player
// could gain by lying about is therefore not writable from the client at all.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMember(sessionId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.connected == true;
    }

    function isGm(sessionId) {
      return isMember(sessionId) && get(
        /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
      ).data.role == 'gm';
    }

    // A member's operational roster is bounded by the server-owned group
    // pointer on that member record.  The query must still include the same
    // group and connected predicates; rules evaluate every candidate document
    // so a client cannot widen this projection by changing its query literal.
    function isCurrentOperationalMember(sessionId) {
      return isMember(sessionId)
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.fleetGroupId is string
        && resource.data.connected == true
        && resource.data.fleetGroupId is string
        && resource.data.fleetGroupId == get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.fleetGroupId;
    }

    function isGmPrivateSecret(secretId) {
      return secretId == 'wolf-assignment' || secretId.matches('setup-receipt-.*');
    }

    function isCanonicalWolfCultProjection(sessionId, intelligenceUid) {
      return isMember(sessionId)
        && intelligenceUid == uid()
        && resource.data.type == 'wolf-cult-intelligence'
        && resource.data.sessionId == sessionId
        && resource.data.recipientUid == uid()
        && resource.data.visibleToUids.size() == 1
        && resource.data.visibleToUids[0] == uid();
    }

    function hasCurrentWolfCultAuthority(sessionId) {
      return isMember(sessionId)
        && exists(
          /databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligenceAuthority/current
        )
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligenceAuthority/current
        ).data.type == 'wolf-cult-intelligence-authority'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligenceAuthority/current
        ).data.recipientUid == uid();
    }

    function isCurrentWolfCultIntelligence(sessionId, intelligenceUid) {
      return isCanonicalWolfCultProjection(sessionId, intelligenceUid)
        && hasCurrentWolfCultAuthority(sessionId);
    }

    // A legacy session can have a current private card before the census
    // backfill has written its authority pointer. This is a narrowly scoped
    // bootstrap: the authenticated member must still be the connected player
    // holding the canonical private card, and an existing projection must
    // carry the same exact audience tuple. Once the authority pointer exists,
    // callers use the strict authority check above.
    function isLegacyWolfCultHolder(sessionId, intelligenceUid) {
      let secretId = 'loyalty-' + uid();
      return isMember(sessionId)
        && intelligenceUid == uid()
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.role == 'player'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.connected == true
        && exists(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        )
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.visibleToUids.size() == 1
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.visibleToUids[0] == uid()
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.payload.type == 'loyalty'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.payload.kind == 'wolf-cult'
        // The projection itself is server-write-only and addressed by the
        // authenticated UID, so the legacy branch can authorize the absent
        // listener without dereferencing resource.data.
        && intelligenceUid == uid();
    }

    function isAssignedRoleBrief(sessionId, briefUid) {
      return isMember(sessionId)
        && briefUid == uid()
        && resource.data.type == 'role-brief'
        && resource.data.sessionId == sessionId
        && resource.data.assignmentUid == uid()
        && resource.data.visibleToUids.size() == 1
        && resource.data.visibleToUids[0] == uid()
        && resource.data.roleId is string
        && resource.data.text is string
        && resource.data.commonRules is string
        && (
          get(
            /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
          ).data.assignedRoleId == resource.data.roleId
          || get(
            /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
          ).data.replacementRoleId == resource.data.roleId
        );
    }

    function isCanonicalArbourProjection(sessionId, visionUid) {
      return isMember(sessionId)
        && visionUid == uid()
        && resource.data.type == 'arbour-vision'
        && resource.data.sessionId == sessionId
        && resource.data.recipientUid == uid()
        && resource.data.visibleToUids.size() == 1
        && resource.data.visibleToUids[0] == uid();
    }

    function hasCurrentArbourAuthority(sessionId) {
      return isMember(sessionId)
        && exists(
          /databases/$(database)/documents/sessions/$(sessionId)/arbourVisionAuthority/current
        )
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/arbourVisionAuthority/current
        ).data.type == 'arbour-vision-authority'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/arbourVisionAuthority/current
        ).data.recipientUid == uid();
    }

    function isCurrentArbourVision(sessionId, visionUid) {
      return isCanonicalArbourProjection(sessionId, visionUid)
        && hasCurrentArbourAuthority(sessionId);
    }

    function isLegacyArbourHolder(sessionId, visionUid) {
      let secretId = 'loyalty-' + uid();
      return isMember(sessionId)
        && visionUid == uid()
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.role == 'player'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
        ).data.connected == true
        && exists(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        )
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.visibleToUids.size() == 1
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.visibleToUids[0] == uid()
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.payload.type == 'loyalty'
        && get(
          /databases/$(database)/documents/sessions/$(sessionId)/secrets/$(secretId)
        ).data.payload.kind == 'universal-arbour'
        && visionUid == uid();
    }

    match /sessions/{sessionId} {
      // Joining by code goes through the callable function, so session headers
      // never need to be exposed to strangers or enumerable from the client.
      allow get: if isMember(sessionId);
      allow list: if false;
      // Created, phased and closed only by callable functions.
      allow create, update, delete: if false;

      match /players/{playerUid} {
        // Facilitators may use the explicit full roster view. Ordinary
        // members receive only connected players in their current
        // server-owned fleet group; a stale group pointer therefore fails
        // closed instead of leaving old operational data readable.
        allow get, list: if isGm(sessionId) || isCurrentOperationalMember(sessionId);

        // Join and resume are server-authoritative: knowing a session document
        // id must never be enough to register yourself as a member.
        allow create: if false;

        // They may change their display name and nothing else.
        allow update: if signedIn()
          && playerUid == uid()
          && resource.data.connected == true
          && request.resource.data.connected == true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40;

        allow delete: if false;
      }

      match /gmInstances/{instanceId} {
        allow get, list: if isMember(sessionId);
        // Claims, kicks and releases also update player authority, so they are
        // one server-side transaction and never a client write.
        allow write: if false;
      }

      match /seats/{seatId} {
        allow get, list: if isMember(sessionId);
        // Seat claims are adjudicated server-side; races must not be resolvable
        // by whoever's write lands first.
        allow write: if false;
      }

      match /secrets/{secretId} {
        allow get, list: if isMember(sessionId)
          && uid() in resource.data.visibleToUids
          && (!isGmPrivateSecret(secretId) || isGm(sessionId));
        allow write: if false;
      }

      // Away-mission hands are private projections. The participant may read
      // only their own hand, while any currently connected GM may facilitate
      // the mission. Checking current role here deliberately revokes a former
      // GM and admits a newly authorized GM without a stale audience snapshot.
      match /awayMissionHands/{handId} {
        allow get: if isMember(sessionId)
          && resource.data.sessionId == sessionId
          && resource.data.participantUid is string
          && (resource.data.participantUid == uid() || isGm(sessionId));
        allow list, write: if false;
      }

      // Dione VIP hands are one server-written private projection per owner.
      // The deck and all ownership transitions remain under serverState; a
      // member can read only the hand addressed by their authenticated UID.
      match /vipHands/{handUid} {
        allow get: if isMember(sessionId)
          && handUid == uid()
          && resource.data.sessionId == sessionId
          && resource.data.ownerUid == uid();
        allow list, write: if false;
      }

      // A role brief is a server-owned per-UID projection. The assignment on
      // the current player record is part of the read boundary, so a stale
      // former assignment cannot be hydrated after release or reassignment.
      match /roleBriefs/{briefUid} {
        allow get: if isAssignedRoleBrief(sessionId, briefUid);
        allow list, write: if false;
      }

      // Wolf Cult intelligence has one private projection for the current
      // Cult holder and one organiser projection for connected facilitators.
      // A legacy current player may subscribe before the census authority
      // pointer is backfilled; the projection remains server-write-only and
      // non-enumerable.
      match /wolfCultIntelligence/{intelligenceUid} {
        allow get: if intelligenceUid == 'current' && isGm(sessionId)
          || (intelligenceUid == uid()
            && (
              (!exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligence/$(intelligenceUid))
                && hasCurrentWolfCultAuthority(sessionId))
              || (exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligence/$(intelligenceUid))
                && isCurrentWolfCultIntelligence(sessionId, intelligenceUid))
              || (!exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligence/$(intelligenceUid))
                && !exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligenceAuthority/current)
                && isLegacyWolfCultHolder(sessionId, intelligenceUid))
              || (exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligence/$(intelligenceUid))
                && !exists(/databases/$(database)/documents/sessions/$(sessionId)/wolfCultIntelligenceAuthority/current)
                && isLegacyWolfCultHolder(sessionId, intelligenceUid)
                && isCanonicalWolfCultProjection(sessionId, intelligenceUid))
            ));
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if intelligenceUid == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      match /wolfCultIntelligenceAuthority/{projectionId} {
        allow read, write: if false;
      }

      // Universal Arbour calls are server-authored and private to the current
      // loyalty holder; the facilitator's current projection is a separate
      // GM-only document so the recipient cannot enumerate author metadata.
      // A legacy current player may subscribe before the census authority
      // pointer is backfilled; the projection remains server-write-only.
      match /arbourVisions/{visionUid} {
        allow get: if visionUid == 'current' && isGm(sessionId)
          || (visionUid == uid()
            && (
              (!exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisions/$(visionUid))
                && hasCurrentArbourAuthority(sessionId))
              || (exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisions/$(visionUid))
                && isCurrentArbourVision(sessionId, visionUid))
              || (!exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisions/$(visionUid))
                && !exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisionAuthority/current)
                && isLegacyArbourHolder(sessionId, visionUid))
              || (exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisions/$(visionUid))
                && !exists(/databases/$(database)/documents/sessions/$(sessionId)/arbourVisionAuthority/current)
                && isLegacyArbourHolder(sessionId, visionUid)
                && isCanonicalArbourProjection(sessionId, visionUid))
            ));
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if visionUid == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      match /arbourVisionAuthority/{projectionId} {
        allow read, write: if false;
      }

      // Hummingbird's server dice and pending allocation are private to the
      // currently active Quellon Explorer. The public session may expose only
      // the completed food/water cargo projection.
      match /hummingbirdHarvests/{harvestUid} {
        allow get: if isMember(sessionId)
          && harvestUid == uid()
          && get(
            /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
          ).data.role == 'player'
          && get(
            /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
          ).data.activeConsoleRoleId == 'quellon-explorer'
          && (
            !('replacementRoleId' in get(
              /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
            ).data)
            || get(
              /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
            ).data.replacementRoleId == null
            || get(
              /databases/$(database)/documents/sessions/$(sessionId)/players/$(uid())
            ).data.replacementRoleId == 'quellon-explorer'
          )
          && resource.data.sessionId == sessionId
          && resource.data.ownerUid == uid();
        allow list, write: if false;
      }

      match /hummingbirdHarvestRequests/{requestId} {
        allow read, write: if false;
      }

      // Replacement adjudications contain player status and role choice. They
      // are private GM projections; the callable is the only writer.
      match /replacementEligibility/{targetUid} {
        allow get, list: if isGm(sessionId);
        allow write: if false;

        match /audit/{auditId} {
          allow get, list: if isGm(sessionId);
          allow write: if false;
        }
      }

      match /replacementAssignments/{assignmentId} {
        allow get, list: if isGm(sessionId);
        allow write: if false;

        match /audit/{auditId} {
          allow get, list: if isGm(sessionId);
          allow write: if false;
        }
      }

      // The facilitator census is a server-written, known-path projection of
      // loyalty kind and suspicion. It is never enumerable or client writable.
      match /loyaltyCensus/{projectionId} {
        allow get: if projectionId == 'current' && isGm(sessionId);
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if projectionId == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      // The approximate Wolf-attack timing marker and its audit trail are
      // facilitator controls, never a player-readable session field.
      match /wolfAttackWindow/{projectionId} {
        allow get: if projectionId == 'current' && isGm(sessionId);
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if projectionId == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      // Private Wolf cards, targets, modifiers, and facilitator notes are a
      // server-owned projection. Every connected GM may read the same
      // revision; players and clients may never write or enumerate it.
      match /wolfAttackPreparation/{projectionId} {
        allow get: if projectionId == 'current' && isGm(sessionId);
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if projectionId == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      // Declaration state keeps the composition, unresolved stage receipt,
      // and parked-craft snapshot available to facilitators only. Members
      // receive the allowlisted declaration event instead.
      match /wolfAttackState/{projectionId} {
        allow get: if projectionId == 'current' && isGm(sessionId);
        allow list, write: if false;

        match /audit/{auditId} {
          allow get, list: if projectionId == 'current' && isGm(sessionId);
          allow write: if false;
        }
      }

      // Mission decks contain the authoritative shuffled order. They are
      // server-only state, including from connected GM devices.
      match /serverState/{document=**} {
        allow read, write: if false;
      }

      // Navigation knowledge is published per authenticated member. The
      // producer derives the group and assigned ship on the server; clients
      // cannot enumerate a group's or another ship's history.
      match /playerDiscoveries/{playerUid} {
        allow get: if isMember(sessionId) && playerUid == uid();
        allow list, write: if false;
      }

      // The organiser projection is a separate allowlisted read path. It is
      // never present on the member-readable session document.
      match /gmDiscovery/{projectionId} {
        allow get: if projectionId == 'current' && isGm(sessionId);
        allow list, write: if false;
      }

      match /events/{eventId} {
        allow get, list: if isMember(sessionId);
        allow write: if false;
      }

      // Loyalty assignment receipts bind retries to a server-side actor and
      // payload fingerprint. They are never part of the public event stream.
      match /loyaltyAssignmentRequests/{requestId} {
        allow read, write: if false;
      }

      // Canonical command receipts bind retries to the action, actor, current
      // authority instance, revision, and complete mutation payload. They can
      // contain prior results and must never enter the member event stream.
      match /commandReceipts/{requestId} {
        allow read, write: if false;
      }

      // Maintenance receipts are server-owned replay state and may contain
      // authoritative command details that are not part of the read model.
      match /maintenanceRequests/{requestId} {
        allow read, write: if false;
      }

      // Rollback receipts are server-owned replay state and remain private to
      // the callable even when the caller is an active GM.
      match /maintenanceRollbackRequests/{requestId} {
        allow read, write: if false;
      }

      // Small-ship docking and maintenance receipts are server-owned replay
      // state and never part of the member-readable session projection.
      match /smallShipRequests/{requestId} {
        allow read, write: if false;
      }

      // Fighter-wing corrections are GM callables with private replay receipts;
      // no client may inspect or forge the correction ledger.
      match /fighterWingCountRequests/{requestId} {
        allow read, write: if false;
      }

      match /damageDraws/{drawId} {
        allow get, list: if isMember(sessionId);
        allow write: if false;
      }

      match /shipConfetti/{shipId} {
        allow get: if isMember(sessionId);
        allow list, write: if false;
      }
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
